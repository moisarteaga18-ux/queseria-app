    <!-- Sombra de las tarjetas (verde muy oscuro y translúcido en lugar de gris) -->
    <color name="sombra">#5514532D</color>

    <!-- Botón "Enviar por WhatsApp" (verde de WhatsApp oscurecido para que el texto blanco se lea bien) -->
    <color name="whatsapp">#1DA851</color>


    <!-- Superficies (tarjetas, diálogos, campos con foco, barra inferior). En modo oscuro cambian (values-night). -->
    <color name="superficie">#FFFDF8</color>
