<?xml version="1.0" encoding="utf-8"?>
<resources>

    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <!-- ===== PALETA QUESODATA (tomada del logo) ===== -->

    <!-- Verdes: el contorno del logo (bosque), el campo (principal) y la palabra "Data" (hoja) -->
    <color name="verde_bosque">#0F3D22</color>        <!-- el más oscuro: barra de estado, degradados -->
    <color name="verde_oscuro">#14532D</color>        <!-- títulos, números importantes, toolbar -->
    <color name="verde_principal">#2E7D32</color>     <!-- botones, acentos, elementos activos -->
    <color name="verde_claro">#8BC34A</color>         <!-- verde hoja/lima: acentos y gráficos -->
    <color name="verde_muy_claro">#EAF4E0</color>     <!-- fondos de íconos y chips -->

    <!-- Crema del queso fresco y blanco -->
    <color name="beige_fondo">#F7F3E8</color>         <!-- fondo crema de todas las pantallas (guía de diseño) -->
    <color name="crema">#F4ECD8</color>               <!-- fondo de campos de texto, separadores -->
    <color name="crema_oscura">#E6DCC3</color>        <!-- bordes suaves -->
    <color name="dorado">#E0A82E</color>              <!-- dorado del atardecer del logo: segunda serie de gráficos -->

    <!-- Textos (casi negro con un toque verde, para que no se vea genérico) -->
