<?xml version="1.0" encoding="utf-8"?>
<!-- Botón redondo del diseño (menú, calendario, recargar): oscuro con borde verde -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <stroke android:width="4dp" android:color="@color/gr_neon_tenue" />
        </shape>
    </item>
    <item android:bottom="2dp" android:left="2dp" android:right="2dp" android:top="2dp">
        <shape android:shape="oval">
            <solid android:color="#CC0E1A12" />
            <stroke android:width="1.5dp" android:color="@color/gr_neon" />
        </shape>
    </item>
</layer-list>
