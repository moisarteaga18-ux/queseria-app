<?xml version="1.0" encoding="utf-8"?>
<!-- Barra inferior flotante de toda la app: oscura con borde verde brillante. El brillo son tres trazos en capas, sin desenfoque,
     para que se dibuje rápido en teléfonos sencillos. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="6dp" android:color="@color/gr_neon_tenue" />
            <corners android:radius="34dp" />
        </shape>
    </item>
    <item android:bottom="3dp" android:left="3dp" android:right="3dp" android:top="3dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:endColor="@color/gr_barra" android:startColor="@color/gr_barra" />
            <stroke android:width="3dp" android:color="@color/gr_neon_suave" />
            <corners android:radius="30dp" />
        </shape>
    </item>
    <item android:bottom="4dp" android:left="4dp" android:right="4dp" android:top="4dp">
        <shape android:shape="rectangle">
            <stroke android:width="1.5dp" android:color="@color/gr_neon" />
            <corners android:radius="29dp" />
        </shape>
    </item>
</layer-list>
