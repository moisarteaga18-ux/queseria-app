<?xml version="1.0" encoding="utf-8"?>
<!-- Opción como tarjeta seleccionable (RadioButton con estilo Queseria.Opcion) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/verde_muy_claro" />
            <corners android:radius="18dp" />
            <stroke android:width="2dp" android:color="@color/verde_principal" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/superficie" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="@color/gris_borde" />
        </shape>
    </item>
</selector>
