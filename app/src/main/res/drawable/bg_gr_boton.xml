<?xml version="1.0" encoding="utf-8"?>
<!-- Botón verde brillante del diseño (Reportes: Comparar con la semana anterior) -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#33FFFFFF">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <stroke android:width="5dp" android:color="@color/gr_neon_tenue" />
                    <corners android:radius="34dp" />
                </shape>
            </item>
            <item android:bottom="3dp" android:left="3dp" android:right="3dp" android:top="3dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="90" android:endColor="#2FBF55" android:startColor="#137A30" />
                    <stroke android:width="1.5dp" android:color="#9BFFB4" />
                    <corners android:radius="30dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
