<?xml version="1.0" encoding="utf-8"?>
<!-- Botón principal: degradado verde campo → verde bosque -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/nav_inactivo" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <ripple android:color="#33FFFFFF">
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="315" android:endColor="@color/verde_bosque" android:startColor="@color/verde_principal" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
        </ripple>
    </item>
</selector>
