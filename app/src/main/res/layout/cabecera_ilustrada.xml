<?xml version="1.0" encoding="utf-8"?>
<!-- Cabecera verde ilustrada de la guía de diseño: foto del campo con velo verde, ilustración abajo a la
     derecha, la vaca del logo arriba a la derecha, botón atrás, título en dos colores y borde ondulado.
     La usan los formularios (formulario_completo), Mi cuenta, Cambiar contraseña y el acceso. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="236dp">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/img_cabecera_campo" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_cabecera_verde" />

    <ImageView
        android:id="@+id/ivIlustracion"
        android:layout_width="wrap_content"
        android:layout_height="140dp"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="16dp"
        android:adjustViewBounds="true"
        android:importantForAccessibility="no"
        android:maxWidth="210dp"
        android:scaleType="fitEnd"
        android:src="@drawable/img_guia_quesos" />

    <ImageView
        android:id="@+id/ivVaca"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="18dp"
        android:elevation="4dp"
        android:importantForAccessibility="no"
        android:src="@drawable/img_guia_vaca_circulo" />

    <ImageButton
        android:id="@+id/btnAtras"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="22dp"
        android:background="@drawable/bg_boton_cabecera_claro"
        android:contentDescription="Atrás"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_flecha_izquierda"
        app:tint="@color/white" />

    <TextView
        android:id="@+id/tvTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="22dp"
        android:layout_marginBottom="52dp"
        android:fontFamily="@font/poppins_bold"
        android:includeFontPadding="false"
        android:lineSpacingMultiplier="0.95"
        android:maxWidth="250dp"
        android:shadowColor="#66000000"
        android:shadowDy="2"
        android:shadowRadius="6"
        android:textColor="@color/white"
        android:textSize="31sp" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_gravity="bottom"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/ola_cabecera" />
</FrameLayout>
