<?xml version="1.0" encoding="utf-8"?>
<!-- "Registrar merma" (manual): se elige una semana ya cerrada; la app muestra lo que sobró y lo propone como
     merma (se puede cambiar). merma + lo pasado a la semana siguiente ≤ lo que sobró. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_panel_semana"
            android:orientation="vertical"
            android:padding="12dp">
            <TextView style="@style/Queseria.Etiqueta" android:drawableStart="@drawable/ic_campo_semana"
                android:layout_marginTop="0dp"
                android:text="¿De qué semana es la merma?" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tarjeta_semana"
                android:elevation="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="8dp">

                <ImageButton
                    android:id="@+id/btnSemanaAnterior"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_circulo_verde_suave"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Semana anterior"
                    android:src="@drawable/ic_flecha_izquierda"
                    app:tint="@color/verde_principal" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tvSemana"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_bold"
                        android:gravity="center"
                        android:textColor="@color/verde_oscuro"
                        android:textSize="22sp" />
                    <TextView
                        android:id="@+id/tvSemanaDias"
                        style="@style/Queseria.TextoSecundario"
                        android:gravity="center" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnSemanaSiguiente"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_circulo_verde_suave"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Semana siguiente"
                    android:src="@drawable/ic_flecha_derecha"
                    app:tint="@color/verde_principal" />
            </LinearLayout>
        </LinearLayout>

        <!-- Producido, vendido, lo que sobró y lo pasado (datos del servidor) -->
        <com.queseria.app.ui.common.Aviso
            android:id="@+id/tvDetalle"
            style="@style/Queseria.Aviso" />

        <TextView style="@style/Queseria.Etiqueta" android:drawableStart="@drawable/ic_campo_queso"
            android:text="Kg de merma (queso que se perdió) *" />
        <EditText
            android:id="@+id/etKg"
            style="@style/Queseria.Input"
            android:hint="0 kg"
            android:inputType="numberDecimal" />
        <TextView
            android:id="@+id/btnSugerida"
            style="@style/Queseria.Opcion.Fila"
            android:layout_width="match_parent"
            android:layout_marginTop="10dp"
            android:button="@null"
            android:clickable="true"
            android:drawableStart="@drawable/ic_campo_queso"
            android:focusable="true"
            android:gravity="center_vertical" />

        <!-- Valor: kg × precio promedio real de venta de esa semana -->
        <TextView
            android:id="@+id/tvValor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/poppins_semibold"
            android:textColor="@color/rojo_error"
            android:textSize="15sp" />

        <com.queseria.app.ui.common.Aviso
            android:id="@+id/tvAyuda"
            style="@style/Queseria.Aviso"
            android:text="Si sobró queso que todavía se puede vender, pásalo a la semana siguiente con «Pasar queso» y registra como merma solo lo que se perdió." />
    </LinearLayout>
</ScrollView>
