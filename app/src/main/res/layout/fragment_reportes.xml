<?xml version="1.0" encoding="utf-8"?>
<!-- Reportes (diseño oscuro con neón). Orden: ganancia de la semana, ventas y leche lado a lado, botón para comparar
     con la semana anterior, gráfico de 8 semanas (ventas verde, leche dorada) y después ganancia por semana,
     rendimiento, merma, mejores clientes e inventario. -->
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipeRefresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gr_fondo">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <include
                android:id="@+id/cabecera"
                layout="@layout/cabecera_gr" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-24dp"
                android:orientation="vertical"
                android:paddingHorizontal="12dp">

                <TextView
                    android:id="@+id/tvError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_gr_tarjeta_roja"
                    android:padding="16dp"
                    android:textColor="@color/gr_texto"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <!-- 1. Ganancia de esta semana -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_gr_tarjeta"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="18dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="12dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/tvGananciaTitulo"
                            style="@style/Gr.Rotulo"
                            android:text="Ganancia de esta semana" />
                        <TextView
                            android:id="@+id/tvGanancia"
                            style="@style/Gr.Valor"
                            android:layout_height="44dp"
                            android:text="—"
                            android:textSize="34sp"
                            app:autoSizeMaxTextSize="34sp" />
                        <TextView
                            android:id="@+id/tvGananciaCambio"
                            style="@style/Gr.Pildora"
                            android:layout_marginTop="8dp" />
                        <TextView
                            android:id="@+id/tvSemanaInfo"
                            style="@style/Gr.Secundario"
                            android:layout_marginTop="6dp" />
                    </LinearLayout>
                    <ImageView
                        android:id="@+id/ivGanancia"
                        android:layout_width="92dp"
                        android:layout_height="86dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/img_gr_circulo_flecha" />
                </LinearLayout>

                <!-- 2. Ventas y leche, lado a lado -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_gr_tarjeta"
                        android:orientation="vertical"
                        android:padding="14dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <ImageView
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/img_gr_monedas" />
                            <TextView
                                style="@style/Gr.Rotulo"
                                android:layout_marginStart="8dp"
                                android:text="Ventas" />
                        </LinearLayout>
                        <TextView
                            android:id="@+id/tvVentas"
                            style="@style/Gr.ValorMediano"
                            android:layout_marginTop="8dp"
                            android:text="—" />
                        <TextView
                            android:id="@+id/tvVentasDetalle"
                            style="@style/Gr.Secundario" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_gr_tarjeta_azul"
                        android:orientation="vertical"
                        android:padding="14dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <ImageView
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/img_gr_jarra_leche" />
                            <TextView
                                style="@style/Gr.Rotulo"
                                android:layout_marginStart="8dp"
                                android:text="Leche" />
                        </LinearLayout>
                        <TextView
                            android:id="@+id/tvLeche"
                            style="@style/Gr.ValorMediano"
                            android:layout_marginTop="8dp"
                            android:text="—" />
                        <TextView
                            android:id="@+id/tvLecheDetalle"
                            style="@style/Gr.Secundario" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 3. Comparar con la semana anterior (abre Ganancias) -->
                <TextView
                    android:id="@+id/btnGanancias"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_gr_boton"
                    android:drawableEnd="@drawable/ic_flecha_derecha"
                    android:drawablePadding="8dp"
                    android:drawableTint="@color/gr_texto"
                    android:ellipsize="end"
                    android:focusable="true"
                    android:fontFamily="@font/poppins_semibold"
                    android:gravity="center"
                    android:maxLines="1"
                    android:paddingHorizontal="24dp"
                    android:text="Comparar con la semana anterior"
                    android:textColor="@color/gr_texto"
                    android:textSize="16sp"
                    app:autoSizeMaxTextSize="16sp"
                    app:autoSizeMinTextSize="12sp"
                    app:autoSizeTextType="uniform" />

                <!-- 4. Ventas y leche comprada, 8 semanas -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_gr_tarjeta"
                    android:orientation="vertical"
                    android:padding="18dp">
                    <TextView
                        style="@style/Gr.Rotulo"
                        android:text="Ventas y leche comprada" />
                    <TextView
                        style="@style/Gr.Secundario"
                        android:text="Últimas 8 semanas (viernes a jueves)" />
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <View
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:background="@drawable/bg_circulo"
                            android:backgroundTint="@color/gr_neon" />
                        <TextView
                            style="@style/Gr.Texto"
                            android:layout_marginStart="6dp"
                            android:text="Ventas"
                            android:textSize="13sp" />
                        <View
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_marginStart="18dp"
                            android:background="@drawable/bg_circulo"
                            android:backgroundTint="@color/gr_oro" />
                        <TextView
                            style="@style/Gr.Texto"
                            android:layout_marginStart="6dp"
                            android:text="Leche comprada"
                            android:textSize="13sp" />
                    </LinearLayout>
                    <com.queseria.app.ui.common.Grafico
                        android:id="@+id/graficoIngresos"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:layout_marginTop="8dp" />
                </LinearLayout>

                <!-- Ganancia por semana -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_gr_tarjeta"
                    android:orientation="vertical"
                    android:padding="18dp">
                    <TextView
                        style="@style/Gr.Rotulo"
                        android:text="Ganancia por semana" />
                    <TextView
                        style="@style/Gr.Secundario"
                        android:text="Ventas menos el costo de la leche" />
                    <com.queseria.app.ui.common.Grafico
                        android:id="@+id/graficoGanancia"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:layout_marginTop="8dp" />
                </LinearLayout>

                <!-- Rendimiento -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_gr_tarjeta"
                    android:orientation="vertical"
                    android:padding="18dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                style="@style/Gr.Rotulo"
                                android:text="Rendimiento de la leche" />
                            <TextView
                                style="@style/Gr.Secundario"
                                android:text="Libras de queso por lata de 20 L" />
                        </LinearLayout>
                        <TextView
                            android:id="@+id/tvRendimiento"
                            style="@style/Gr.ValorMediano"
                            android:layout_width="wrap_content"
                            android:text="—"
                            android:textColor="@color/gr_neon" />
                    </LinearLayout>
                    <com.queseria.app.ui.common.Grafico
                        android:id="@+id/graficoRendimiento"
                        android:layout_width="match_parent"
                        android:layout_height="170dp"
                        android:layout_marginTop="8dp" />
                    <TextView
                        android:id="@+id/tvMejorSemana"
                        style="@style/Gr.Secundario"
                        android:textColor="@color/gr_positivo" />
                    <TextView
                        android:id="@+id/tvPeorSemana"
                        style="@style/Gr.Secundario"
                        android:textColor="@color/gr_negativo" />
                    <TextView
                        android:id="@+id/btnRendimiento"
                        style="@style/Gr.Pildora"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_gr_pildora_verde"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="Ver rendimiento por semana"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Merma -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_gr_tarjeta_roja"
                    android:orientation="vertical"
                    android:padding="18dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                style="@style/Gr.Rotulo"
                                android:text="Merma del queso" />
                            <TextView
                                style="@style/Gr.Secundario"
                                android:text="% de lo producido · solo semanas completas" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/tvMermaPromedio"
                                style="@style/Gr.ValorMediano"
                                android:layout_width="wrap_content"
                                android:text="—"
                                android:textColor="@color/gr_rojo" />
                            <TextView
                                style="@style/Gr.Secundario"
                                android:text="promedio"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>
                    <com.queseria.app.ui.common.Grafico
                        android:id="@+id/graficoMerma"
                        android:layout_width="match_parent"
                        android:layout_height="170dp"
                        android:layout_marginTop="8dp" />
                    <LinearLayout
                        android:id="@+id/contenedorMerma"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="vertical" />
                </LinearLayout>

                <!-- Mejores clientes -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_gr_tarjeta"
                    android:orientation="vertical"
                    android:padding="18dp">
                    <TextView
                        style="@style/Gr.Rotulo"
                        android:text="Mejores clientes" />
                    <TextView
                        style="@style/Gr.Secundario"
                        android:text="Ventas de los últimos 30 días" />
                    <LinearLayout
                        android:id="@+id/contenedorClientes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical" />
                </LinearLayout>

                <!-- Inventario -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_gr_tarjeta"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="18dp">
                    <ImageView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_gr_boton_redondo"
                        android:importantForAccessibility="no"
                        android:padding="13dp"
                        android:src="@drawable/ic_inventario"
                        app:tint="@color/gr_neon" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            style="@style/Gr.Rotulo"
                            android:text="Inventario a precio de venta" />
                        <TextView
                            android:id="@+id/tvInventarioValor"
                            style="@style/Gr.ValorMediano"
                            android:layout_marginTop="4dp"
                            android:text="$ 0" />
                        <TextView
                            android:id="@+id/tvInventarioDetalle"
                            style="@style/Gr.Secundario" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
