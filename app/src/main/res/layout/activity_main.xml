<?xml version="1.0" encoding="utf-8"?>
<!-- Barra superior + pantallas + barra inferior (Inicio, Reportes, Ventas, Más) de la guía de diseño.
     La casita de la barra superior también vuelve a Inicio. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/beige_fondo"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <!-- "Sin internet · datos guardados del 19 nov, 9:40 p. m." y lo que falta por subir (toca = ver la lista) -->
    <TextView
        android:id="@+id/tvSinInternet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/aviso_sin_internet"
        android:drawablePadding="8dp"
        android:fontFamily="@font/poppins_medium"
        android:gravity="center_vertical"
        android:minHeight="36dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="6dp"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:visibility="gone"
        app:drawableStartCompat="@drawable/ic_alerta"
        app:drawableTint="@color/white" />

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:elevation="0dp"
        app:navigationIconTint="@color/white"
        app:title="@string/app_name" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host_fragment"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:defaultNavHost="true"
        app:navGraph="@navigation/nav_graph" />

    <include
        android:id="@+id/barraInferior"
        layout="@layout/barra_inferior" />

</LinearLayout>
