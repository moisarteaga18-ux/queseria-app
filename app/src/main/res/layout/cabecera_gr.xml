<?xml version="1.0" encoding="utf-8"?>
<!-- Cabecera de Ganancias y Reportes (diseño oscuro): foto del campo con la vaca al atardecer que se funde
     con el fondo, botón de menú, título grande, acción a la derecha (Reportes: recargar) y la vaca en un
     círculo con anillo verde. Los textos y botones son de código; la foto es solo la zona limpia. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="150dp">

    <ImageView
        android:id="@+id/ivFoto"
        android:layout_width="match_parent"
        android:layout_height="190dp"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/img_gr_cabecera" />

    <View
        android:layout_width="match_parent"
        android:layout_height="190dp"
        android:background="@drawable/bg_gr_velo_izquierda" />

    <View
        android:layout_width="match_parent"
        android:layout_height="190dp"
        android:background="@drawable/bg_gr_velo_cabecera" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_gr_boton_redondo"
                android:contentDescription="Menú"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_qd_menu"
                app:tint="@color/gr_texto" />

            <TextView
                android:id="@+id/tvTitulo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:fontFamily="@font/poppins_bold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:shadowColor="#CC000000"
                android:shadowRadius="8"
                android:textColor="@color/gr_texto"
                android:textSize="28sp"
                app:autoSizeMaxTextSize="28sp"
                app:autoSizeMinTextSize="18sp"
                app:autoSizeTextType="uniform" />

            <!-- Reportes: recargar. Ganancias no lleva campana: no hay notificaciones en la app. -->
            <ImageButton
                android:id="@+id/btnAccion"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_gr_boton_redondo"
                android:contentDescription="Recargar"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_gr_recargar"
                android:visibility="gone"
                app:tint="@color/gr_texto" />

            <ImageView
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:importantForAccessibility="no"
                android:src="@drawable/img_gr_vaca_circulo" />
        </LinearLayout>

        <!-- Solo Ganancias: "Tu negocio más rentable" con trazo verde -->
        <LinearLayout
            android:id="@+id/lema"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical"
            android:visibility="gone">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semibold"
                android:lineSpacingMultiplier="0.9"
                android:shadowColor="#CC000000"
                android:shadowRadius="6"
                android:text="Tu negocio\nmás rentable"
                android:textColor="@color/gr_texto"
                android:textSize="18sp" />
            <ImageView
                android:layout_width="130dp"
                android:layout_height="10dp"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/deco_gr_trazo" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
