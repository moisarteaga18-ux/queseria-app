<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingBottom="8dp">

        <TextView style="@style/Queseria.Etiqueta" android:drawableStart="@drawable/ic_campo_producto"
            android:text="Producto" />
        <Spinner
            android:id="@+id/spProducto"
            style="@style/Queseria.Desplegable" />

        <TextView style="@style/Queseria.Etiqueta" android:drawableStart="@drawable/ic_campo_tipo"
            android:text="Tipo de movimiento" />
        <RadioGroup
            android:id="@+id/rgTipo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <RadioButton
                android:id="@+id/rbEntrada"
                style="@style/Queseria.Opcion.Fila"
                android:checked="true"
                android:drawableStart="@drawable/ic_campo_entrada"
                android:text="Entrada" />
            <RadioButton
                android:id="@+id/rbSalida"
                style="@style/Queseria.Opcion.Fila"
                android:drawableStart="@drawable/ic_campo_salida"
                android:text="Salida" />
        </RadioGroup>

        <TextView
            android:id="@+id/lblCantidad"
            style="@style/Queseria.Etiqueta"
            android:drawableStart="@drawable/ic_campo_bascula"
            android:text="Cantidad" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <EditText
                android:id="@+id/etCantidad"
                style="@style/Queseria.Input"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:hint="0"
                android:inputType="numberDecimal" />
            <RadioGroup
                android:id="@+id/rgUnidad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:orientation="horizontal">
                <RadioButton
                android:id="@+id/rbKg"
                style="@style/Queseria.Opcion.Unidad"
                android:checked="true"
                android:text="kg" />
                <RadioButton
                android:id="@+id/rbLb"
                style="@style/Queseria.Opcion.Unidad"
                android:text="lb" />
            </RadioGroup>
        </LinearLayout>

        <com.queseria.app.ui.common.Aviso
            android:id="@+id/tvStockActual"
            style="@style/Queseria.Aviso" />

        <TextView
            style="@style/Queseria.Aviso"
            android:text="La merma no se registra aquí: se calcula sola al cierre de cada semana (jueves)." />

        <TextView style="@style/Queseria.Etiqueta" android:drawableStart="@drawable/ic_campo_nota"
            android:text="Motivo" />
        <EditText
            android:id="@+id/etMotivo"
            style="@style/Queseria.Input"
            android:hint="Ej: regalo, muestra, consumo propio"
            android:inputType="textCapSentences" />

    </LinearLayout>
</ScrollView>
