<?xml version="1.0" encoding="utf-8"?>
<!-- Mi perfil: datos del negocio y del dueño. El usuario de inicio de sesión no se cambia. -->
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/swipeRefresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/beige_fondo">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include
                android:id="@+id/cabecera"
                layout="@layout/cabecera_ilustrada" />


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="24dp">

                <TextView style="@style/Queseria.Etiqueta" android:drawableStart="@drawable/ic_campo_usuario"
            android:text="Usuario para iniciar sesión" />
                <TextView
                    android:id="@+id/tvUsuario"
                    style="@style/Queseria.Input"
                    android:layout_width="match_parent"
                    android:alpha="0.7"
                    android:drawableStart="@drawable/ic_cliente"
                    android:drawablePadding="12dp"
                    android:gravity="center_vertical" />
                <TextView
                    style="@style/Queseria.TextoSecundario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="El usuario no se puede cambiar." />

                <TextView style="@style/Queseria.Etiqueta" android:drawableStart="@drawable/ic_campo_negocio"
            android:text="Nombre del negocio *" />
                <EditText
                    android:id="@+id/etNombreNegocio"
                    style="@style/Queseria.Input"
                    android:layout_width="match_parent"
                    android:drawableStart="@drawable/ic_tienda"
                    android:drawablePadding="12dp"
                    android:hint="Ej: Quesería La Esperanza"
                    android:inputType="textCapWords"
                    android:maxLength="100" />

                <TextView style="@style/Queseria.Etiqueta" android:drawableStart="@drawable/ic_campo_persona"
            android:text="Nombre del dueño" />
                <EditText
                    android:id="@+id/etPropietario"
                    style="@style/Queseria.Input"
                    android:layout_width="match_parent"
                    android:drawableStart="@drawable/ic_cliente"
                    android:drawablePadding="12dp"
                    android:hint="Opcional"
                    android:inputType="textPersonName|textCapWords"
                    android:maxLength="100" />

                <TextView style="@style/Queseria.Etiqueta" android:drawableStart="@drawable/ic_campo_telefono"
            android:text="Teléfono" />
                <EditText
                    android:id="@+id/etTelefono"
                    style="@style/Queseria.Input"
                    android:layout_width="match_parent"
                    android:drawableStart="@drawable/ic_telefono"
                    android:drawablePadding="12dp"
                    android:hint="Opcional"
                    android:inputType="phone"
                    android:maxLength="30" />

                <TextView style="@style/Queseria.Etiqueta" android:drawableStart="@drawable/ic_campo_correo"
            android:text="Correo electrónico" />
                <EditText
                    android:id="@+id/etEmail"
                    style="@style/Queseria.Input"
                    android:layout_width="match_parent"
                    android:drawableStart="@drawable/ic_correo"
                    android:drawablePadding="12dp"
                    android:hint="tucorreo@ejemplo.com"
                    android:inputType="textEmailAddress"
                    android:maxLength="100" />
                <TextView
                    style="@style/Queseria.TextoSecundario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Ahí te llega el código si olvidas tu contraseña. Sin correo no se puede recuperar." />

                <TextView style="@style/Queseria.Etiqueta" android:drawableStart="@drawable/ic_campo_ubicacion"
            android:text="Dirección" />
                <EditText
                    android:id="@+id/etDireccion"
                    style="@style/Queseria.Input"
                    android:layout_width="match_parent"
                    android:drawableStart="@drawable/ic_ubicacion"
                    android:drawablePadding="12dp"
                    android:hint="Opcional"
                    android:inputType="textPostalAddress|textCapSentences"
                    android:maxLength="150" />

                <TextView style="@style/Queseria.Etiqueta" android:drawableStart="@drawable/ic_campo_negocio"
            android:text="NIT o cédula" />
                <EditText
                    android:id="@+id/etNit"
                    style="@style/Queseria.Input"
                    android:layout_width="match_parent"
                    android:drawableStart="@drawable/ic_liquidacion"
                    android:drawablePadding="12dp"
                    android:hint="Opcional"
                    android:inputType="text"
                    android:maxLength="30" />

                <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancelar"
                    style="@style/Queseria.BotonCancelar"
                    android:layout_width="0dp"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:text="Cancelar" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGuardar"
                    style="@style/Queseria.BotonGuardar"
                    android:layout_width="0dp"
                    android:layout_weight="1.15"
                    android:enabled="false"
                    android:text="Guardar" />
            </LinearLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_marginHorizontal="-24dp"
                android:layout_marginTop="12dp">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_guia_paisaje_finca" />
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY"
                    android:src="@drawable/ola_pie" />
            </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
